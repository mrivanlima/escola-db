digraph database_schema {
    rankdir=TB;
    node [shape=record, style=filled, fillcolor=lightblue];
    fontname="Arial";
    fontsize=10;
    
    // ========================================
    // IDENTITY SCHEMA
    // ========================================
    
    subgraph cluster_identity {
        label="Identity Schema";
        style=filled;
        color=lightgrey;
        
        tenants [label="{tenants|tenant_id (PK)\ltenant_uuid (UK)\ltenant_name\ltenant_name_normalized\ltenant_type\lis_active\l...audit fields\l}", fillcolor="#E8F4F8"];
        
        app_users [label="{app_users|user_id (PK)\luser_uuid (UK)\ltenant_id (FK)\lauth_user_id (UK)\lfull_name\lfull_name_normalized\lemail\lemail_normalized\luser_role\lis_active\l...audit fields\l}", fillcolor="#E8F4F8"];
    }
    
    // ========================================
    // ASSETS SCHEMA
    // ========================================
    
    subgraph cluster_assets {
        label="Assets Schema";
        style=filled;
        color=lightgrey;
        
        media_files [label="{media_files|file_id (PK)\ltenant_id (FK)\lstorage_path\loriginal_name\loriginal_name_normalized\lmime_type\lsize_bytes\lalt_text\lalt_text_normalized\lmetadata (JSONB)\l...audit fields\l}", fillcolor="#FFF4E6"];
    }
    
    // ========================================
    // SCHOOL SCHEMA
    // ========================================
    
    subgraph cluster_school {
        label="School Schema";
        style=filled;
        color=lightgrey;
        
        students [label="{students|student_id (PK)\lstudent_uuid (UK)\ltenant_id (FK)\lnickname + normalized\lfirst_name + normalized\lmiddle_name + normalized\llast_name + normalized\lbirth_date\lavatar_config (JSONB)\lis_active\l...audit fields\l}", fillcolor="#E8F5E9"];
        
        guardians [label="{guardians|guardian_id (PK)\lguardian_uuid (UK)\ltenant_id (FK)\luser_id (FK)\lphone_number\lrelationship\lis_primary\l...audit fields\l}", fillcolor="#E8F5E9"];
        
        student_guardians [label="{student_guardians|student_guardian_id (PK)\lstudent_id (FK)\lguardian_id (FK)\ltenant_id (FK)\lrelationship_notes + normalized\lis_authorized_pickup\l...audit fields\l}", fillcolor="#E8F5E9"];
        
        classes [label="{classes|class_id (PK)\lclass_uuid (UK)\ltenant_id (FK)\lclass_name + normalized\lgrade_level + normalized\lschool_year + normalized\lmax_students\lclass_config (JSONB)\lis_active\l...audit fields\l}", fillcolor="#E8F5E9"];
        
        teachers [label="{teachers|teacher_id (PK)\lteacher_uuid (UK)\ltenant_id (FK)\luser_id (FK)\lspecialization + normalized\lhire_date\lteacher_config (JSONB)\lis_active\l...audit fields\l}", fillcolor="#E8F5E9"];
        
        class_students [label="{class_students|class_student_id (PK)\lclass_id (FK)\lstudent_id (FK)\ltenant_id (FK)\lenrollment_date\lstatus\l...audit fields\l}", fillcolor="#E8F5E9"];
    }
    
    // ========================================
    // CONTENT SCHEMA
    // ========================================
    
    subgraph cluster_content {
        label="Content Schema";
        style=filled;
        color=lightgrey;
        
        modules [label="{modules|module_id (PK)\lmodule_uuid (UK)\lmodule_name + normalized\ldescription + normalized\lmodule_type\ldifficulty_level\lrecommended_age_min/max\ldisplay_order\lthumbnail_url\lmodule_config (JSONB)\lis_published\l...audit fields\l}", fillcolor="#F3E5F5"];
        
        activities [label="{activities|activity_id (PK)\lactivity_uuid (UK)\lmodule_id (FK)\lactivity_name + normalized\ldescription + normalized\lactivity_type\ldisplay_order\lestimated_duration\lpoints_reward\lactivity_data (JSONB)\lthumbnail_url\lis_published\l...audit fields\l}", fillcolor="#F3E5F5"];
        
        assets [label="{assets|asset_id (PK)\lasset_uuid (UK)\lasset_name + normalized\lasset_type\lfile_url\lfile_size_bytes\lmime_type\lduration_seconds\ldimensions (JSONB)\lalt_text + normalized\lasset_metadata (JSONB)\lis_published\l...audit fields\l}", fillcolor="#F3E5F5"];
    }
    
    // ========================================
    // GAME SCHEMA
    // ========================================
    
    subgraph cluster_game {
        label="Game Schema";
        style=filled;
        color=lightgrey;
        
        student_progress [label="{student_progress|progress_id (PK)\lprogress_uuid (UK)\lstudent_id (FK)\lactivity_id (FK)\ltenant_id (FK)\lstatus\lscore\lattempts\ltime_spent_seconds\lprogress_data (JSONB)\lcompleted_at\l...audit fields\l}", fillcolor="#FFEBEE"];
        
        badges [label="{badges|badge_id (PK)\lbadge_uuid (UK)\lbadge_name + normalized\ldescription + normalized\lbadge_type\licon_url\lrarity\lpoints_value\lunlock_criteria (JSONB)\ldisplay_order\lis_active\l...audit fields\l}", fillcolor="#FFEBEE"];
        
        student_badges [label="{student_badges|student_badge_id (PK)\lstudent_id (FK)\lbadge_id (FK)\ltenant_id (FK)\learned_at\learn_metadata (JSONB)\l...audit fields\l}", fillcolor="#FFEBEE"];
    }
    
    // ========================================
    // RELATIONSHIPS
    // ========================================
    
    // Identity relationships
    tenants -> app_users [label="has"];
    tenants -> media_files [label="owns"];
    tenants -> students [label="has"];
    tenants -> guardians [label="has"];
    tenants -> classes [label="has"];
    tenants -> teachers [label="has"];
    tenants -> student_progress [label="has"];
    tenants -> student_guardians [label="has"];
    tenants -> class_students [label="has"];
    tenants -> student_badges [label="has"];
    
    // School relationships
    app_users -> guardians [label="is (1:1)"];
    app_users -> teachers [label="is (1:1)"];
    
    students -> student_guardians [label="has"];
    guardians -> student_guardians [label="has"];
    
    students -> class_students [label="enrolled"];
    classes -> class_students [label="contains"];
    
    students -> student_progress [label="tracks"];
    students -> student_badges [label="earned"];
    
    // Content relationships
    modules -> activities [label="contains"];
    activities -> student_progress [label="tracked"];
    
    // Game relationships
    badges -> student_badges [label="awarded"];
    
    // Legend
    label = "\nEscola Platform - Database Schema\n17 Tables | 6 Schemas | 22 Normalized Columns\nHybrid IDs: Internal INT + External UUID\nAll TEXT columns have *_normalized for accent-insensitive search";
    labelloc = "b";
    fontsize = 14;
}
