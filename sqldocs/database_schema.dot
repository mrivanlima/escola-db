digraph database_schema {
    rankdir=TB;
    node [shape=record, style=filled, fillcolor=lightblue];
    fontname="Arial";
    fontsize=10;
    
    // ========================================
    // IDENTITY SCHEMA
    // ========================================
    
    subgraph cluster_identity {
        label="Identity Schema";
        style=filled;
        color=lightgrey;
        
        tenants [label="{tenants|tenant_id (PK)\ltenant_uuid (UK)\ltenant_name\ltenant_name_normalized\ltenant_type\lis_active\l...audit fields\l}", fillcolor="#E8F4F8"];
        
        app_users [label="{app_users|user_id (PK)\luser_uuid (UK)\ltenant_id (FK)\lauth_user_id (UK)\lfull_name\lfull_name_normalized\lemail\lemail_normalized\luser_role\lis_active\l...audit fields\l}", fillcolor="#E8F4F8"];
    }
    
    // ========================================
    // ASSETS SCHEMA
    // ========================================
    
    subgraph cluster_assets {
        label="Assets Schema";
        style=filled;
        color=lightgrey;
        
        media_files [label="{media_files|file_id (PK UUID)\ltenant_id (FK)\lstorage_path\loriginal_name\loriginal_name_normalized\lmime_type\lsize_bytes\lalt_text\lalt_text_normalized\lmetadata (JSONB)\l...audit fields\l}", fillcolor="#FFF4E6"];
    }
    
    // ========================================
    // SCHOOL SCHEMA
    // ========================================
    
    subgraph cluster_school {
        label="School Schema";
        style=filled;
        color=lightgrey;
        
        students [label="{students|student_id (PK)\lstudent_uuid (UK)\ltenant_id (FK)\lnickname + normalized\lfirst_name + normalized\lmiddle_name + normalized\llast_name + normalized\lbirth_date\lavatar_config (JSONB)\lis_active\l...audit fields\l}", fillcolor="#E8F5E9"];
        
        guardians [label="{guardians|guardian_id (PK)\lguardian_uuid (UK)\ltenant_id (FK)\luser_id (FK)\lphone_number\lrelationship\lis_primary\l...audit fields\l}", fillcolor="#E8F5E9"];
        
        student_guardians [label="{student_guardians|sg_id (PK)\lsg_uuid (UK)\ltenant_id (FK)\lstudent_id (FK)\lguardian_id (FK)\lrelationship_notes + normalized\lis_authorized_pickup\l...audit fields\l}", fillcolor="#E8F5E9"];
        
        classes [label="{classes|class_id (PK)\lclass_uuid (UK)\ltenant_id (FK)\lclass_name + normalized\lgrade_level + normalized\lschool_year + normalized\lmax_students\lclass_config (JSONB)\lis_active\l...audit fields\l}", fillcolor="#E8F5E9"];
        
        teachers [label="{teachers|teacher_id (PK)\lteacher_uuid (UK)\ltenant_id (FK)\luser_id (FK)\lspecialization + normalized\lhire_date\lteacher_config (JSONB)\lis_active\l...audit fields\l}", fillcolor="#E8F5E9"];
        
        class_students [label="{class_students|cs_id (PK)\lcs_uuid (UK)\ltenant_id (FK)\lclass_id (FK)\lstudent_id (FK)\lenrollment_date\lstatus\l...audit fields\l}", fillcolor="#E8F5E9"];
    }
    
    // ========================================
    // CONTENT SCHEMA
    // ========================================
    
    subgraph cluster_content {
        label="Content Schema";
        style=filled;
        color=lightgrey;
        
        modules [label="{modules|module_id (PK)\lmodule_uuid (UK)\lmodule_name + normalized\ldescription + normalized\lmodule_type\ldifficulty_level\lrecommended_age_min\lrecommended_age_max\ldisplay_order\lmodule_config (JSONB)\lis_published\l...audit fields\l}", fillcolor="#FCE4EC"];
        
        activities [label="{activities|activity_id (PK)\lactivity_uuid (UK)\lmodule_id (FK)\lactivity_name + normalized\ldescription + normalized\lactivity_type\ldisplay_order\lestimated_duration\lpoints_reward\lactivity_data (JSONB)\lis_published\l...audit fields\l}", fillcolor="#FCE4EC"];
        
        activity_resources [label="{activity_resources|resource_id (PK)\lresource_uuid (UK)\lactivity_id (FK)\lresource_name + normalized\lresource_type\lmedia_file_id (FK UUID)\ldisplay_order\lis_required\lusage_context\lresource_config (JSONB)\lis_published\l...audit fields\l}", fillcolor="#FCE4EC"];
    }
    
    // ========================================
    // GAME SCHEMA
    // ========================================
    
    subgraph cluster_game {
        label="Game Schema";
        style=filled;
        color=lightgrey;
        
        student_progress [label="{student_progress|progress_id (PK)\lprogress_uuid (UK)\ltenant_id (FK)\lstudent_id (FK)\lactivity_id (FK)\lstatus\lscore\ltime_spent_seconds\lattempts_count\lcompletion_date\lprogress_data (JSONB)\l...audit fields\l}", fillcolor="#F3E5F5"];
        
        badges [label="{badges|badge_id (PK)\lbadge_uuid (UK)\lbadge_name + normalized\ldescription + normalized\lbadge_type\lrarity\lpoints_value\lunlock_criteria (JSONB)\ldisplay_order\lis_active\l...audit fields\l}", fillcolor="#F3E5F5"];
        
        student_badges [label="{student_badges|sb_id (PK)\lsb_uuid (UK)\ltenant_id (FK)\lstudent_id (FK)\lbadge_id (FK)\learned_at\lprogress_id (FK)\l...audit fields\l}", fillcolor="#F3E5F5"];
    }
    
    // ========================================
    // RELATIONSHIPS
    // ========================================
    
    // Identity relationships
    app_users -> tenants [label="tenant_id"];
    
    // Assets relationships
    media_files -> tenants [label="tenant_id"];
    
    // School relationships
    students -> tenants [label="tenant_id"];
    guardians -> tenants [label="tenant_id"];
    guardians -> app_users [label="user_id"];
    student_guardians -> tenants [label="tenant_id"];
    student_guardians -> students [label="student_id"];
    student_guardians -> guardians [label="guardian_id"];
    classes -> tenants [label="tenant_id"];
    teachers -> tenants [label="tenant_id"];
    teachers -> app_users [label="user_id"];
    class_students -> tenants [label="tenant_id"];
    class_students -> classes [label="class_id"];
    class_students -> students [label="student_id"];
    
    // Content relationships
    activities -> modules [label="module_id"];
    activity_resources -> activities [label="activity_id"];
    activity_resources -> media_files [label="media_file_id", style=dashed, color=blue];
    
    // Game relationships
    student_progress -> tenants [label="tenant_id"];
    student_progress -> students [label="student_id"];
    student_progress -> activities [label="activity_id"];
    student_badges -> tenants [label="tenant_id"];
    student_badges -> students [label="student_id"];
    student_badges -> badges [label="badge_id"];
    student_badges -> student_progress [label="progress_id", style=dashed];
}
